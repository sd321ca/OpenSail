{
  "name": "opensail-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Client build for the OpenSail dashboard.",
  "scripts": {
    "dev": "vite",
    "build:js": "vite build",
    "watch:js": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -c tailwind.config.js -i web/assets/input.css -o web/assets/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i web/assets/input.css -o web/assets/styles.css --watch",
    "build": "npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
