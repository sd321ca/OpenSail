__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
todo.md

# Virtual environments
.venv/
venv/
env/

# OS / editor noise
.DS_Store
Thumbs.db

# Frontend build dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated client build output. Run `npm run build` after changing sources;
# see AGENTS.md for the TypeScript/Vite layout.
web/assets/app.js
web/assets/styles.css
# Client source maps are regenerated by `npm run build:js`
web/assets/*.map

# Saved voice-cloning references (auto-generated, machine-specific)
voices/

# Per-user data: workspace files, media, thumbnails and the SQLite database
data/

# Cached image thumbnails used by the Image Gallery (auto-generated)
thumbnails/

# Local media drop folder shown in the galleries (user content)
media/

# Locally generated TLS certificates / private keys
configs/certs/*
!configs/certs/.gitkeep

# Workflows and machine-specific config. The per-owner workspace files
# (workflow_fields, workflow_presets, workflow_notes, chat_personas) live under
# data/, which is ignored above.
workflows/
configs/audio_models.json
configs/chat_models.json
configs/constants.json
configs/fields.json
configs/samplers.json
configs/schedulers.json

# Atomic-write leftovers from the config editors
configs/*.tmp
