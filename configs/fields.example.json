{
  "_comment": "Declarative registry of the Generate tab's input controls. Each entry defines a control key, widget type, widget-specific options, and an optional match spec that maps workflow node inputs to this widget. A field without match falls back to matching an input with the same key. Labels shown in the UI come from the workflow node titles. Add a new entry here to add a new input without touching ui.py.",
  "fields": [
    {
      "key": "prompt",
      "widget": "textbox",
      "options": {
        "placeholder": "Describe the image you want...",
        "lines": 3
      },
      "match": {
        "node_types": [
          "CLIPTextEncode",
          "TextEncodeQwenImage21",
          "MiniMaxH3ImageToVideo",
          "MiniMaxH3ReferenceToVideo"
        ],
        "linked_node_types": [
          "PrimitiveString",
          "PrimitiveStringMultiline"
        ],
        "input_keys": [
          "text",
          "prompt",
          "value"
        ]
      }
    },
    {
      "key": "negative_prompt",
      "widget": "textbox",
      "options": {
        "placeholder": "Describe what to avoid...",
        "lines": 2
      },
      "match": {
        "node_types": [
          "CLIPTextEncode",
          "TextEncodeQwenImage21",
          "MiniMaxH3ImageToVideo",
          "MiniMaxH3ReferenceToVideo"
        ],
        "input_keys": [
          "negative_prompt"
        ]
      }
    },
    {
      "key": "steps",
      "widget": "slider",
      "options": {
        "minimum": 1,
        "maximum": 50,
        "step": 1
      }
    },
    {
      "key": "cfg",
      "widget": "slider",
      "options": {
        "minimum": 0.0,
        "maximum": 20.0,
        "step": 0.1
      }
    },
    {
      "key": "denoise",
      "widget": "slider",
      "options": {
        "minimum": 0.0,
        "maximum": 1.0,
        "step": 0.01
      }
    },
    {
      "key": "sampler_name",
      "widget": "dropdown",
      "options": {
        "choices_source": "samplers"
      }
    },
    {
      "key": "scheduler",
      "widget": "dropdown",
      "options": {
        "choices_source": "schedulers"
      }
    },
    {
      "key": "style",
      "widget": "textbox",
      "options": {
        "placeholder": "Describe the musical style...",
        "lines": 3
      },
      "match": {
        "music_key": "style"
      }
    },
    {
      "key": "lyrics",
      "widget": "textbox",
      "options": {
        "placeholder": "Enter the song lyrics...",
        "lines": 8
      },
      "match": {
        "music_key": "lyrics"
      }
    },
    {
      "key": "max_duration",
      "widget": "slider",
      "options": {
        "minimum": 10,
        "maximum": 300,
        "step": 5
      }
    },
    {
      "key": "mode",
      "widget": "dropdown",
      "options": {
        "choices_source": "music_modes"
      },
      "match": {
        "node_types": [
          "YuE2GenerateMusic"
        ],
        "input_keys": [
          "mode"
        ]
      }
    },
    {
      "key": "duration",
      "widget": "slider",
      "options": {
        "minimum": 1,
        "maximum": 30,
        "step": 1
      },
      "match": {
        "node_types": [
          "PrimitiveFloat"
        ],
        "input_keys": [
          "value"
        ]
      }
    },
    {
      "key": "seed",
      "widget": "number",
      "options": {
        "precision": 0
      },
      "match": {
        "node_types": [
          "KSampler",
          "KSamplerSelect",
          "SeedNode",
          "RandomNoise"
        ],
        "input_keys": [
          "seed",
          "noise_seed"
        ]
      }
    },
    {
      "key": "aspect_ratio",
      "widget": "dropdown",
      "options": {
        "choices_source": "aspect_ratios"
      },
      "match": {
        "node_types": [
          "ResolutionSelector"
        ],
        "input_keys": [
          "aspect_ratio"
        ]
      }
    },
    {
      "key": "megapixels",
      "widget": "slider",
      "options": {
        "minimum": 0.1,
        "maximum": 4.0,
        "step": 0.1
      },
      "match": {
        "node_types": [
          "ResolutionSelector"
        ],
        "input_keys": [
          "megapixels"
        ]
      }
    },
    {
      "key": "width",
      "widget": "slider",
      "options": {
        "minimum": 256,
        "maximum": 2048,
        "step": 64
      },
      "match": {
        "node_types": [
          "EmptyLatentImage",
          "EmptyFlux2LatentImage"
        ],
        "input_keys": [
          "width"
        ]
      }
    },
    {
      "key": "height",
      "widget": "slider",
      "options": {
        "minimum": 256,
        "maximum": 2048,
        "step": 64
      },
      "match": {
        "node_types": [
          "EmptyLatentImage",
          "EmptyFlux2LatentImage"
        ],
        "input_keys": [
          "height"
        ]
      }
    },
    {
      "key": "batch_size",
      "widget": "slider",
      "options": {
        "minimum": 1,
        "maximum": 4,
        "step": 1
      },
      "match": {
        "node_types": [
          "EmptyLatentImage",
          "EmptyYuE2LatentAudio",
          "EmptyFlux2LatentImage"
        ],
        "input_keys": [
          "batch_size"
        ]
      }
    }
  ]
}
